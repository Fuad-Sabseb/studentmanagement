# Backend server
PORT=5001
NODE_ENV=development

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=student_management_db

# Auth (REQUIRED - must be a random string of at least 32 characters)
JWT_SECRET=replace_this_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed frontend origins (A05 CORS hardening)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
